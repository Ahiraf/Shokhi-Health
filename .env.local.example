# Local dev config for Shokhi (Next.js). Copy to .env.local (git-ignored).
# The backend now lives inside this same app (app/api/*), so there is NO separate server.

# Hosted Gemma 4 via Google AI Studio — SERVER-SIDE only (never exposed to the browser).
# Get a free key at https://aistudio.google.com. Without any key, the app falls back to a
# deterministic mock backend so everything still runs.
GOOGLE_API_KEY=paste_your_key_here

# Optional extra keys (from different Google accounts) for automatic quota fallback:
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=

# Optional overrides:
# SHOKHI_GEMMA_MODEL=gemma-4-26b-a4b-it
# SHOKHI_BACKEND=gemini            # "gemini", "local", or "mock"
# SHOKHI_THINKING=high             # optional; default is adaptive (minimal/routine, high/ambiguous)
# SHOKHI_LLM_EXTRACT=0             # opt out of structured Gemma intake and use deterministic extraction
# SHOKHI_SAFETY_NET=0              # optional extra Gemma safety check; deterministic triage stays on
# Local/private mode (Ollama or another OpenAI-compatible Gemma server):
# SHOKHI_LOCAL_GEMMA_URL=http://127.0.0.1:11434/v1/chat/completions
# SHOKHI_LOCAL_GEMMA_MODEL=gemma-4-e4b-it
# SHOKHI_LOCAL_ASR_URL=http://127.0.0.1:8000/transcribe  # optional local speech-to-text endpoint
# SHOKHI_STT_MODEL=gemini-2.5-flash          # voice→text model (uses the SAME GOOGLE_API_KEY; no OpenAI)
# SHOKHI_VISION_MODEL=gemini-2.5-flash        # reads a photo of a report, same key

# Optional: only if you point the frontend at an EXTERNAL backend instead of this app.
# NEXT_PUBLIC_API_URL=
